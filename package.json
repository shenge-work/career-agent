{
  "name": "career-agent",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "description": "CareerAgent - 个人求职 Agent 工作台（本地服务器 + 账号行级隔离）",
  "scripts": {
    "dev": "concurrently -k -n server,web -c gray,white \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "DEV_SKIP_AUTH=true ts-node -r tsconfig-paths/register src/server/main.ts",
    "dev:web": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc -p tsconfig.json && vite build",
    "start": "node dist-server/server/main.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "ts-node src/server/db/migrate.ts",
    "seed:user": "ts-node src/server/db/seed-user.ts",
    "import:v1": "ts-node src/server/db/import-v1.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@electric-sql/pglite-socket": "^0.2.18",
    "@fastify/multipart": "^10.1.8",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-fastify": "^12.3.2",
    "@node-rs/argon2": "^2.2.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.3.2",
    "@tanstack/react-query": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^9.0.0",
    "drizzle-kit": "^0.31.11",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
