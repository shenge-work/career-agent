# 云函数侧（部署到 CloudBase 时由运行环境注入，云函数内一般可免密钥）
TCB_ENV_ID=your-env-id
# 只有本地直连 CloudBase 时才需要；云函数内留空，SDK 自动使用临时密钥
TENCENTCLOUD_SECRETID=
TENCENTCLOUD_SECRETKEY=

# 本地客户端侧（只写进本机环境，绝不进仓库、绝不打包进前端）
# HTTP 访问服务地址，形如 https://<env>.ap-shanghai.app.tcloudbase.com/<function-path>
TCB_SYNC_BASE_URL=
# 若上面的地址已包含函数路径，这里填同一段前缀；留空表示挂在域名根下
TCB_SYNC_PATH_PREFIX=
# 网关要求的额外请求头，JSON 对象且值必须是字符串；核心 x-ca-* 头不可覆盖
# 例：TCB_SYNC_EXTRA_HEADERS={"x-gateway-token":"..."}
TCB_SYNC_EXTRA_HEADERS=
