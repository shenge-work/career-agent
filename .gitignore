# 简历工作室（Resume Studio）—— 本地服务器形态
# 运行数据（PGlite 数据库、迁移前备份）绝不入库
pgdata/
pgdata-corrupt*/
pgdata-corrupted-*/
backups/

# Cloudflare Workers / Miniflare 本地运行态（D1/R2/KV 缓存、临时 bundle），非源码
.wrangler/
.dev.vars

# 构建产物
dist-server/
dist-web/
drizzle/generated/
cloud/sync-cloudbase/dist/
cloud/sync-server/dist/

# 依赖与日志
node_modules/
npm-debug.log*
yarn-error.log*
*.log

# 环境变量（含本地配置，不入库）
.env

# 原始简历数据（v1 迁移前的事实源快照；内容已导入 pgdata，保留作历史备份）
data/

# 本机设备身份（每台设备独立生成，跨设备同步靠它，绝不入库）
device.json

# 系统与编辑器
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# 本地 Agent / 工具状态（含本地记忆、运行日志，不入库）
.workbuddy/

# 临时调试脚本（一次性验证产物，不入库）
.temp/
